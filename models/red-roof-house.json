      "hex": "#7a2426"
    }
  },
  "steps": [
    {
      "step": 1,
      "title": "芝生の土台",
      "description": "緑の2×12を6本、前後方向に並べて12×12の芝生をつくります。この上に家の壁が横切るように載り、土台全体をつなぎます。"
    },
    {
      "step": 2,
      "title": "庭と小道",
      "description": "正面の庭に砂色の2×3で小道を敷き、左右に深緑の2×2で植え込みをつくります。"
    },
    {
      "step": 3,
      "title": "壁の1段目",
      "description": "砂色のブロックで10×8の壁の1段目を立てます。正面中央の2スタッドには茶色の1×2を置いて扉の下端にします。"
    },
    {
      "step": 4,
      "title": "壁の2段目と窓",
      "description": "白いブロックで2段目を積みます。継ぎ目が下の段とずれるように置き、窓の位置には透明ブルーを入れます。"
    },
    {
      "step": 5,
      "title": "壁の3段目",
      "description": "3段目も継ぎ目をずらして積みます。窓と扉はもう1段上まで続きます。"
    },
    {
      "step": 6,
      "title": "壁の4段目（まぐさ）",
      "description": "白いブロックで4段目を積み、扉と窓の上をふさぎます。壁はここまでです。"
    },
    {
      "step": 7,
      "title": "軒と破風",
      "description": "前後に屋根の軒を2列ずつ、壁より1スタッド外まで張り出して載せます。左右の壁の上には白い1×6で三角の破風の最下段をつくります。"
    },
    {
      "step": 8,
      "title": "屋根 2段目",
      "description": "1スタッド内側にずらして屋根の2段目を載せます。継ぎ目が下段と重ならないよう2×4を3本ずつ使います。破風は1×4です。"
    },
    {
      "step": 9,
      "title": "屋根 3段目",
      "description": "さらに1スタッド内側に屋根を載せ、破風の頂上に1×2を置きます。"
    },
    {
      "step": 10,
      "title": "屋根 4段目",
      "description": "屋根の4段目です。前後の列が破風の頂上をはさんで固定します。"
    },
    {
      "step": 11,
      "title": "棟（むね）",
      "description": "最後に屋根の頂上へ2×6を2本載せて、前後の屋根をつなぎます。完成です。"
    }
  ],
