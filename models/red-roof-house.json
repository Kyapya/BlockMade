  "name": "赤い屋根の家",
  "nameEn": "Red-Roof House",
  "description": "芝生の土台に建つ、切妻屋根の小さな家。正面に扉と2つの窓、庭には小道と植え込み。",
  "author": "Claude",
  "createdAt": "2026-09-23",
  "colors": {
    "green": {
      "name": "Green",
      "hex": "#2e8b50"
    },
    "tan": {
      "name": "Tan",
      "hex": "#d6b97c"
    },
