  "steps": [
    {
      "step": 1,
      "title": "展示スタンド",
      "description": "ダークグレーの4×6を台座に置き、黒の2×4と2×2を2段重ねて支柱にします。"
    },
    {
      "step": 2,
      "title": "キール（竜骨）",
      "description": "支柱の上に明るいグレーの2×10を前後方向に載せます。機体の背骨になります。"
    },
    {
      "step": 3,
      "title": "機体の下半分",
      "description": "キールの上に白い4×6と4×4、機首の2×4を前後に並べます。"
    },
    {
      "step": 4,
      "title": "腹部の張り出し",
      "description": "機体の下にグレーの1×6を左右1本ずつ、下から差し込みます。"
    },
    {
      "step": 5,
      "title": "主翼",
      "description": "明るいグレーの2×12を2本、左右方向に機体の上へ渡して主翼にします。"
    },
    {
      "step": 6,
      "title": "機体の上半分",
      "description": "主翼の前後に白い2×4を載せ、後ろには機体から張り出す2×4を置きます。"
    },
    {
      "step": 7,
      "title": "キャノピーと機首",
      "description": "透明ブルーの2×2でキャノピー、赤い2×2で機首の上面をつくります。"
    },
    {
      "step": 8,
      "title": "メインエンジン",
      "description": "機体後部の張り出しの下に、透明オレンジの1×2をエンジン噴射口として差し込みます。"
    },
    {
      "step": 9,
      "title": "機関砲",
      "description": "主翼の下に黒い1×4を左右1本ずつ、前向きに差し込みます。"
    },
    {
      "step": 10,
      "title": "エンジンポッド",
      "description": "主翼の上の左右にダークグレーの2×4を載せます。後ろに1スタッド張り出します。"
    },
    {
      "step": 11,
      "title": "ポッドの噴射口",
      "description": "ポッドの張り出しの下に透明オレンジの1×2を差し込みます。"
    },
    {
      "step": 12,
      "title": "翼端",
      "description": "主翼の両端に赤い1×4を載せます。"
    },
    {
      "step": 13,
      "title": "背面とキャノピー上部",
      "description": "主翼の中央にダークグレーの2×4、キャノピーの上に透明ブルーの1×2を重ねます。"
    },
    {
      "step": 14,
      "title": "航行灯",
      "description": "左の翼端に透明レッド、右の翼端に透明グリーンの1×1を載せます。"
    },
    {
      "step": 15,
      "title": "尾翼",
      "description": "背面の上に赤い1×3と1×2を重ねて尾翼を立てます。完成です。"
    }
  ],
