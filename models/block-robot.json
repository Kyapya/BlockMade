  "steps": [
    {
      "step": 1,
      "title": "足",
      "description": "ダークグレーの2×4を2つ、2スタッド空けて並べます。"
    },
    {
      "step": 2,
      "title": "脚",
      "description": "足の中央に2×2を3段ずつ積みます。真ん中の段はひざとしてダークグレーにします。"
    },
    {
      "step": 3,
      "title": "腰",
      "description": "ダークグレーの2×6を左右の脚にまたがせて載せ、両脚をつなぎます。"
    },
    {
      "step": 4,
      "title": "胴体の下段",
      "description": "青い4×6を腰の上に載せます。前後に1スタッドずつ張り出します。"
    },
    {
      "step": 5,
      "title": "胸とランプ",
      "description": "青い2×4を左右に、中央に2×3を置き、正面中央には透明レッドの1×2をランプとして入れます。"
    },
    {
      "step": 6,
      "title": "胴体の上段",
      "description": "青い4×6で胸の部品をまとめてふさぎます。"
    },
    {
      "step": 7,
      "title": "肩",
      "description": "ダークグレーの2×10を胴体の上に左右方向に渡します。両端が2スタッドずつ張り出して腕の付け根になります。"
    },
    {
      "step": 8,
      "title": "腕",
      "description": "肩の張り出しの下に2×2を上から順に3段ずつ吊り下げ、いちばん下は黒い手にします。"
    },
    {
      "step": 9,
      "title": "肩当て",
      "description": "肩の両端の上に赤い2×2を載せます。"
    },
    {
      "step": 10,
      "title": "首と頭の後ろ",
      "description": "肩の中央にダークグレーの2×2で首を立て、その上に明るいグレーの2×6で頭の後ろ半分をつくります。"
    },
    {
      "step": 11,
      "title": "頭のてっぺん",
      "description": "明るいグレーの1×6を後ろに、2×6を前に載せます。前の2×6は顔の部分まで1スタッド張り出します。"
    },
    {
      "step": 12,
      "title": "顔",
      "description": "てっぺんの張り出しの下に顔の部品を差し込みます。透明イエローの1×1が目になります。"
    },
    {
      "step": 13,
      "title": "アンテナ",
      "description": "頭の上にダークグレーの1×1を2本立て、先端に透明レッドの1×1を載せて完成です。"
    }
  ],
