  "steps": [
    {
      "step": 1,
      "title": "土台 1段目",
      "description": "ダークグレーの2×8を4本、長い辺を前後(Z)方向に向けて左右に隙間なく並べ、8×8の正方形の土台をつくります。"
    },
    {
      "step": 2,
      "title": "土台 2段目",
      "description": "2×8を4本、90°回して1段目と直交するように重ねます。各ブロックが1段目の4本すべてをまたぐので、土台全体が1つに固定されます。"
    },
    {
      "step": 3,
      "title": "石段と植え込み",
      "description": "正面中央に砂色の2×2を置いて石段にし、土台の四隅に緑の2×2で植え込みをつくります。"
    },
    {
      "step": 4,
      "title": "塔の1段目",
      "description": "土台中央の4×4の範囲に壁を立てます。背面に1×4、左右に1×2。正面は扉口を空けるため、両端に1×1の柱だけを置きます。"
    },
    {
      "step": 5,
      "title": "扉",
      "description": "扉口から1スタッド奥に茶色の1×2を2段積み、奥まった扉にします。"
    },
    {
      "step": 6,
      "title": "塔の2段目",
      "description": "左右に1×4を前後方向に載せ、下段の継ぎ目をまたがせます。背面には1×2。正面は扉口なので空けたままにします。"
    },
    {
      "step": 7,
      "title": "扉の上のまぐさ",
      "description": "正面に砂色の1×4を渡して扉口の上をふさぎます（まぐさ）。左右の柱が両端を支えます。背面に1×4、左右に1×2を置いて段を仕上げます。"
    },
    {
      "step": 8,
      "title": "前後の窓",
      "description": "左右に1×4を載せ、前後の中央に透明ブルーの1×2を入れて窓にします。"
    },
    {
      "step": 9,
      "title": "左右の窓",
      "description": "前後に1×4を渡し、左右の中央に透明ブルーの1×2を入れて側面の窓にします。"
    },
    {
      "step": 10,
      "title": "時計下の帯",
      "description": "砂色のブロックで1段積み、時計部分の下に装飾の帯をつくります。積み方は2段目と同じです。"
    },
    {
      "step": 11,
      "title": "時計部の四隅",
      "description": "塔の4つの角に金色の1×1を立てます。"
    },
    {
      "step": 12,
      "title": "時計の文字盤",
      "description": "時計がプリントされた白い1×2×2（2段分の高さ）を4面に取り付けます。文字盤は外側に向けます。"
    },
    {
      "step": 13,
      "title": "四隅の2段目",
      "description": "金色の1×1をもう1段重ね、文字盤と高さをそろえます。"
    },
    {
      "step": 14,
      "title": "軒（コーニス）",
      "description": "前後に2×6、左右に2×2を置いて、塔より1スタッド張り出した6×6の軒をつくります。内側の列が時計部の上にかみ合って支えます。"
    },
    {
      "step": 15,
      "title": "角の飾り",
      "description": "軒の四隅の張り出し部分に金色の1×1を立てます。"
    },
    {
      "step": 16,
      "title": "屋根",
      "description": "赤い2×4を2本並べて4×4の屋根にします。この2本が軒の4つの部品をまたいで1つにまとめます。"
    },
    {
      "step": 17,
      "title": "頂部",
      "description": "中央に赤い2×2を重ね、最後に金色の2×2を頂上に載せて完成です。"
    }
  ],
