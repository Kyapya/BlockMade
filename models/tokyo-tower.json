  "steps": [
    {
      "step": 1,
      "title": "土台のプレート",
      "description": "緑の8×8プレートを4枚並べて、16×16の土台をつくります。"
    },
    {
      "step": 2,
      "title": "中央のプレート",
      "description": "明るいグレーの8×8プレートを中央に重ね、4枚の土台をまとめて固定します。"
    },
    {
      "step": 3,
      "title": "正面ゲート",
      "description": "正面に白い1×1を2本立て、その上に1×6アーチを渡し、白い1×6タイルで仕上げます。"
    },
    {
      "step": 4,
      "title": "脚 1段目",
      "description": "オレンジの2×2を4本の脚に1個ずつ、前の段から1スタッド内側へずらして積みます。四隅の土台プレートの上から始めます。"
    },
    {
      "step": 5,
      "title": "脚 2段目",
      "description": "白の2×2を4本の脚に1個ずつ、前の段から1スタッド内側へずらして積みます。"
    },
    {
      "step": 6,
      "title": "脚 3段目",
      "description": "オレンジの2×2を4本の脚に1個ずつ、前の段から1スタッド内側へずらして積みます。"
    },
    {
      "step": 7,
      "title": "脚 4段目",
      "description": "白の2×2を4本の脚に1個ずつ、前の段から1スタッド内側へずらして積みます。"
    },
    {
      "step": 8,
      "title": "脚 5段目",
      "description": "オレンジの2×2を4本の脚に1個ずつ、前の段から1スタッド内側へずらして積みます。"
    },
    {
      "step": 9,
      "title": "脚 6段目",
      "description": "白の2×2を4本の脚に1個ずつ、前の段から1スタッド内側へずらして積みます。"
    },
    {
      "step": 10,
      "title": "展望台の床",
      "description": "白い8×8プレートを4本の脚の上に載せて、展望台の床にします。"
    },
    {
      "step": 11,
      "title": "展望台の窓",
      "description": "透明ブルーの1×8を前後、1×6を左右に置いて、窓の輪をつくります。"
    },
    {
      "step": 12,
      "title": "展望台の屋根",
      "description": "明るいグレーの8×8プレートで窓の輪にふたをします。"
    },
    {
      "step": 13,
      "title": "屋根のスロープとタイル",
      "description": "4×2スロープを四方に外向きに置き、四隅の空いたところを2×2タイルで平らに仕上げます。"
    },
    {
      "step": 14,
      "title": "上部の塔 1段目",
      "description": "オレンジの2×4を2本並べて4×4の段をつくります。段ごとに向きを90°変えて、継ぎ目をずらします。"
    },
    {
      "step": 15,
      "title": "上部の塔 2段目",
      "description": "白の2×4を2本並べて4×4の段をつくります。段ごとに向きを90°変えて、継ぎ目をずらします。"
    },
    {
      "step": 16,
      "title": "上部の塔 3段目",
      "description": "オレンジの2×4を2本並べて4×4の段をつくります。段ごとに向きを90°変えて、継ぎ目をずらします。"
    },
    {
      "step": 17,
      "title": "上部の塔 4段目",
      "description": "白の2×4を2本並べて4×4の段をつくります。段ごとに向きを90°変えて、継ぎ目をずらします。"
    },
    {
      "step": 18,
      "title": "上部の塔 5段目",
      "description": "オレンジの2×4を2本並べて4×4の段をつくります。段ごとに向きを90°変えて、継ぎ目をずらします。"
    },
    {
      "step": 19,
      "title": "上部の塔 6段目",
      "description": "白の2×4を2本並べて4×4の段をつくります。段ごとに向きを90°変えて、継ぎ目をずらします。"
    },
    {
      "step": 20,
      "title": "特別展望台の床",
      "description": "白い6×6プレートを塔の上に載せます。"
    },
    {
      "step": 21,
      "title": "特別展望台の窓",
      "description": "透明ブルーの1×6を前後、1×4を左右に置いて、小さな窓の輪をつくります。"
    },
    {
      "step": 22,
      "title": "特別展望台の屋根",
      "description": "明るいグレーの6×6プレートでふたをします。"
    },
    {
      "step": 23,
      "title": "アンテナ",
      "description": "2×2丸ブロックをオレンジ・白の順に2個、1×1丸ブロックを3個重ね、最後に白いコーンを載せて完成です。"
    }
  ],
